rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // حساب المدير: يقرأ بيانات كل المنشآت (للوحة الإدارة فقط) ولا يكتب في بيانات غيره
    function isAdmin() { return signedIn() && request.auth.token.email == 'weesjjjdu@gmail.com'; }
    function mine() { return signedIn() && resource.data.owner == request.auth.uid; }
    function minting() { return signedIn() && request.resource.data.owner == request.auth.uid; }
    function keepsOwner() { return request.resource.data.owner == resource.data.owner; }
    function parentOwner(token) {
      return get(/databases/$(database)/documents/accounts/$(token)).data.owner == request.auth.uid;
    }

    match /accounts/{token} {
      allow get: if true;
      allow list: if mine() || isAdmin();
      allow create: if minting() && token.size() >= 32;
      allow update: if mine() && keepsOwner();
      allow delete: if mine();

      match /tx/{txId} {
        allow read: if exists(/databases/$(database)/documents/accounts/$(token));
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/accounts/$(token)).data.owner == request.auth.uid;
        allow delete: if signedIn() && parentOwner(token);
        allow update: if false;
      }

      match /subs/{subId} {
        allow create, update: if exists(/databases/$(database)/documents/accounts/$(token))
          && request.resource.data.keys().hasOnly(['sub','ts'])
          && request.resource.data.sub is string
          && request.resource.data.sub.size() < 2500;
        allow read, delete: if signedIn() && parentOwner(token);
      }
    }

    match /suppliers/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting();
      allow update: if mine() && keepsOwner();
      allow delete: if mine();
    }
    match /products/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting();
      allow update: if mine() && keepsOwner();
      allow delete: if mine();
    }
    match /employees/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting();
      allow update: if mine() && keepsOwner();
      allow delete: if mine();
    }
    match /sales/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting();
      allow delete: if mine();
    }
    match /purchases/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting();
      allow delete: if mine();
    }
    match /expenses/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting();
    }
    match /ledger/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow delete: if mine();
    }

    // ===== جديد: طلبات المطعم =====
    match /orders/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting();
      allow update: if mine() && keepsOwner();
      allow delete: if mine();
    }

    // ===== جديد: شيكات التاجر =====
    match /checks/{id} {
      allow read: if mine() || isAdmin();
      allow create: if minting();
      allow update: if mine() && keepsOwner();
      allow delete: if mine();
    }

    match /settings/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
